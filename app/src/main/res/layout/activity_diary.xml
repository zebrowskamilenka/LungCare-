<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">


    <ImageView
        android:id="@+id/bgLungs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.10"
        android:scaleType="centerCrop"
        android:src="@drawable/lungs" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dzienniczek zdrowia"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:paddingBottom="10dp" />

            <!-- DATA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:contentDescription="@null"
                        android:alpha="0.85"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pick_date"
                        android:textColor="#222"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:contentDescription="@null"
                        android:alpha="0.6" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PARAMETRY -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🫁 Parametry"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:textSize="14sp"
                        android:paddingBottom="10dp" />

                    <!-- siatka 2x2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- FEV1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#1A000000">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FEV1"
                                    android:textStyle="bold"
                                    android:textColor="#333"
                                    android:textSize="12sp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusBottomEnd="14dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etFev1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="L"
                                        android:inputType="numberDecimal"
                                        android:minHeight="48dp"
                                        android:paddingTop="12dp"
                                        android:paddingBottom="12dp"/>
                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- SpO2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#1A000000">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SpO₂"
                                    android:textStyle="bold"
                                    android:textColor="#333"
                                    android:textSize="12sp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusBottomEnd="14dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etSpo2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="%"
                                        android:inputType="number"
                                        android:minHeight="48dp"
                                        android:paddingTop="12dp"
                                        android:paddingBottom="12dp" />
                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <!-- Temp -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#1A000000">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Temperatura"
                                    android:textStyle="bold"
                                    android:textColor="#333"
                                    android:textSize="12sp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusBottomEnd="14dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etTemp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="@string/hint_temp"
                                        android:inputType="numberDecimal"
                                        android:minHeight="48dp"
                                        android:paddingTop="12dp"
                                        android:paddingBottom="12dp"/>
                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tętno -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#1A000000">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tętno"
                                    android:textStyle="bold"
                                    android:textColor="#333"
                                    android:textSize="12sp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    android:minHeight="48dp"
                                    android:paddingTop="12dp"
                                    android:paddingBottom="12dp">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etHr"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="bpm"
                                        android:inputType="number"
                                        android:minHeight="48dp"
                                        android:paddingTop="12dp"
                                        android:paddingBottom="12dp"
                                        />
                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SAMOPOCZUCIE jako ChipGroup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Samopoczucie"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:textSize="14sp"
                        android:paddingBottom="10dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodGood"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:text="🙂 Dobre" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodOk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:text="😐 Średnie" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodBad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:text="😞 Złe" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OBJAWY jako chipsy multi-select -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Objawy"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:textSize="14sp"
                        android:paddingBottom="10dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSymptoms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="false"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympCough"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:text="Kaszel" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympDyspnea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:text="Duszność" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympFever"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:text="Gorączka" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympSputum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:text="Plwocina" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympChestPain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:text="Ból klp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSympFatigue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:text="Osłabienie" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- opcjonalne "inne" -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOtherSymptoms"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Inne objawy (opcjonalnie)"
                            android:inputType="textCapSentences"
                            android:minHeight="48dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEKI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Leki przyjęte"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:textSize="14sp"
                        android:paddingBottom="10dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        android:minHeight="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMeds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Np. takrolimus 2 mg 8:00, MMF 10:00…"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:minHeight="48dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ZAPIS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Zapisz wpis"
                android:textSize="16sp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                app:cornerRadius="24dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>