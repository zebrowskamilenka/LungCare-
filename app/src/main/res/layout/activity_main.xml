<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- Ikona użytkownika (prosty kształt) -->
    <TextView
        android:id="@+id/userIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤"
        android:textSize="48sp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/heroStack"
        android:layout_width="364dp"
        android:layout_height="564dp"
        app:layout_constraintBottom_toTopOf="@id/cbShow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userIcon"
        app:layout_constraintVertical_bias="0.10"
        app:layout_constraintWidth_percent="0.92">

        <!-- PŁUCA w tle (POWIĘKSZONE) -->
        <ImageView
            android:id="@+id/lungsImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/lungs"
            android:scaleType="fitCenter"
            android:src="@drawable/lungs" />

        <!-- OVERLAY: pola + przycisk na dole płuc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/etLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/field_bg"
                android:hint="Login"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#14233B"
                android:textColorHint="#334566"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <EditText
                android:id="@+id/etHaslo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/field_bg"
                android:hint="Hasło"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#14233B"
                android:textColorHint="#334566"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <!-- ⬇️ PRZYCISK JEST W KONTENERZE -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="230dp"
                android:layout_height="60dp"
                android:background="@drawable/button_bg"
                android:elevation="6dp"
                android:text="LOGIN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>


    <!-- „Pokaż hasło” pod blokiem płuc -->

    <CheckBox
        android:id="@+id/cbShow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Pokaż hasło"
        android:textColor="#CFE4F7"
        app:layout_constraintStart_toStartOf="@id/heroStack"
        app:layout_constraintTop_toBottomOf="@id/heroStack" />

<!--    <Button-->
<!--        android:id="@+id/loginButton"-->
<!--        android:layout_width="230dp"-->
<!--        android:layout_height="60dp"-->
<!--        android:background="@drawable/button_bg"-->
<!--        android:text="LOGIN"-->
<!--        tools:layout_editor_absoluteX="90dp"-->
<!--        tools:layout_editor_absoluteY="559dp" />-->





</androidx.constraintlayout.widget.ConstraintLayout>
