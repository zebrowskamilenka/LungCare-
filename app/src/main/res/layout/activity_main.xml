<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- Ikona użytkownika (prosty kształt) -->
    <TextView
        android:id="@+id/userIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤"
        android:textSize="48sp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/heroStack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/userIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"/>

        <!-- PŁUCA w tle (POWIĘKSZONE) -->
        <ImageView
            android:id="@+id/lungsImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/lungs"
            android:scaleType="fitCenter"
            android:src="@drawable/lungs" />

        <!-- OVERLAY: pola + przycisk na dole płuc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- LOGIN -->
        <EditText
            android:id="@+id/etLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Login"
            android:textColor="#14233B"
            android:textColorHint="#334566"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/field_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textEmailAddress" />

        <View android:layout_width="match_parent" android:layout_height="10dp"/>

        <!-- HASŁO -->
        <EditText
            android:id="@+id/etHaslo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Hasło"
            android:textColor="#14233B"
            android:textColorHint="#334566"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/field_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword" />

        <!-- POKAŻ HASŁO wewnątrz kontenera -->
        <CheckBox
            android:id="@+id/cbShow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pokaż hasło"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_gravity="start"/>

        <View android:layout_width="match_parent" android:layout_height="14dp"/>

        <!-- LOGIN BUTTON -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="230dp"
            android:layout_height="60dp"
            android:text="LOGIN"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:elevation="6dp"/>
    </LinearLayout>


