<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@drawable/gradient_bg">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tytuł -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dzienniczek zdrowia"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingBottom="20dp" />

        <!-- DATA -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wybierz datę"
            android:textColor="#444"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="@drawable/card_white"
            android:drawablePadding="10dp"/>

        <!-- SAMOPOCZUCIE -->
        <EditText
            android:id="@+id/etMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Samopoczucie (np. dobre, średnie, złe)"
            android:padding="15dp"
            android:background="@drawable/card_white"
            android:textColor="#222"
            android:layout_marginTop="15dp" />

        <!-- OBJAWY -->
        <EditText
            android:id="@+id/etSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Objawy (np. kaszel, duszność)"
            android:padding="15dp"
            android:background="@drawable/card_white"
            android:textColor="#222"
            android:layout_marginTop="15dp" />

        <!-- LEKI -->
        <EditText
            android:id="@+id/etMeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Leki przyjęte"
            android:padding="15dp"
            android:background="@drawable/card_white"
            android:textColor="#222"
            android:layout_marginTop="15dp" />

        <!-- PRZYCISK -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zapisz wpis"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="25dp"
            android:padding="12dp"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>
