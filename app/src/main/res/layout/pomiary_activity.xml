<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:padding="16dp">
    <ImageView
        android:id="@+id/lungsImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/lungs"
        android:scaleType="fitCenter"
        android:src="@drawable/lungs" />
    <!-- Nagłówek -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Wyniki i pomiary"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Podgląd trendów i ostatnich wartości"
        android:textColor="#DCE7F5"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scroll z kartami -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- KARTA: Zakres -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zakres"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B1B2B"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn7"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="7 dni"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn30"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="30 dni"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn90"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="90 dni"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTA: FEV1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFev1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvFev1Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FEV1"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0B1B2B"/>

                        <TextView
                            android:id="@+id/tvFev1Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.1"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#0B1B2B"/>

                        <TextView
                            android:id="@+id/tvFev1Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="L"
                            android:textSize="14sp"
                            android:textColor="#64748B"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFev1Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ostatni pomiar: dziś 08:15"
                        android:textSize="13sp"
                        android:textColor="#64748B"/>

                    <!-- Placeholder na wykres -->
                    <FrameLayout
                        android:id="@+id/chartFev1"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTA: Saturacja -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvSpo2Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Saturacja"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0B1B2B"/>

                        <TextView
                            android:id="@+id/tvSpo2Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="97"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#0B1B2B"/>

                        <TextView
                            android:id="@+id/tvSpo2Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="%"
                            android:textSize="14sp"
                            android:textColor="#64748B"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSpo2Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ostatni pomiar: dziś 12:00"
                        android:textSize="13sp"
                        android:textColor="#64748B"/>

                    <FrameLayout
                        android:id="@+id/chartSpo2"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTA: Temperatura -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvTempTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Temperatura"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0B1B2B"/>

                        <TextView
                            android:id="@+id/tvTempValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="36.7"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#0B1B2B"/>

                        <TextView
                            android:id="@+id/tvTempUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="°C"
                            android:textSize="14sp"
                            android:textColor="#64748B"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTempSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ostatni pomiar: wczoraj 19:10"
                        android:textSize="13sp"
                        android:textColor="#64748B"/>

                    <FrameLayout
                        android:id="@+id/chartTemp"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Przycisk dodawania (pływający) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddMeasurement"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="+ Dodaj pomiar"
        app:cornerRadius="18dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
