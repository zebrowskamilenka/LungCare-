<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    tools:context=".ContactActivity">

    <ImageView
        android:id="@+id/lungsImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/lungs"
        android:scaleType="fitCenter"
        android:alpha="0.10"
        android:src="@drawable/lungs" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_uck"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/field_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/contact_uck_hours"
                        android:textSize="14sp"
                        android:textColor="@color/field_hint"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUckCall"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:text="@string/btn_call"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            app:backgroundTint="@color/btn_start"
                            app:cornerRadius="14dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUckMail"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/btn_email"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/field_text"
                            app:strokeColor="@color/btn_start"
                            app:strokeWidth="2dp"
                            app:cornerRadius="14dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUckMap"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/btn_nav"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/field_text"
                            app:strokeColor="@color/btn_start"
                            app:strokeWidth="2dp"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_coord"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/field_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/contact_coord_desc"
                        android:textSize="14sp"
                        android:textColor="@color/field_hint"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCoordCall"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:text="@string/btn_call"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            app:backgroundTint="@color/btn_start"
                            app:cornerRadius="14dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCoordMail"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/btn_email"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/field_text"
                            app:strokeColor="@color/btn_start"
                            app:strokeWidth="2dp"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_psych"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/field_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/contact_psych_desc"
                        android:textSize="14sp"
                        android:textColor="@color/field_hint"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPsychCall"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:text="@string/btn_call"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            app:backgroundTint="@color/btn_start"
                            app:cornerRadius="14dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPsychMail"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/btn_email"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/field_text"
                            app:strokeColor="@color/btn_start"
                            app:strokeWidth="2dp"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_urgent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#DC3545"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/contact_urgent_desc"
                        android:textSize="14sp"
                        android:textColor="@color/field_hint"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUrgentCall"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_call_now"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:backgroundTint="#DC3545"
                        app:cornerRadius="14dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>