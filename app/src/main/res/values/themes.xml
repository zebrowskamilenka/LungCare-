<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Główny motyw aplikacji - Pełna stabilizacja Material 3 -->
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Kolory podstawowe -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DBEAFE</item>
        <item name="colorOnPrimaryContainer">#1E40AF</item>

        <!-- Powierzchnie i tła -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">#64748B</item>
        <item name="android:colorBackground">#F8FAFC</item>

        <!-- Akcenty -->
        <item name="colorSecondary">#64748B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorError">#EF4444</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- Pasek stanu -->
        <item name="android:statusBarColor">#2563EB</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Definicje typografii dla uniknięcia błędów InflateException -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Material3.HeadlineSmall</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <!-- Brakujące style dla Toolbar (Naprawa błędu linking failed) -->
    <style name="Theme.MyApplication.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.MyApplication.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.MyApplication.NoActionBar" parent="Theme.MyApplication">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
