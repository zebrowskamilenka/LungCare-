<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ciemniejszy cień (dół/prawo) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#15263B"/>
        </shape>
    </item>

    <!-- jaśniejszy "highlight" (góra/lewo) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#2A3D58"/>
        </shape>
    </item>

    <!-- właściwa karta (poszarzała) -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#E8EEF6"/>
        </shape>
    </item>

</layer-list>
